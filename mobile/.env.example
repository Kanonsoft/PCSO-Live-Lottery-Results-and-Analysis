# Keep false for ad-free testing. Set true only in the monetized production environment.
EXPO_PUBLIC_ADS_ENABLED=false

# Public AdMob unit identifiers. Keep real per-environment values in EAS or a local .env file.
EXPO_PUBLIC_ADMOB_BANNER_TOP_ANDROID_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
EXPO_PUBLIC_ADMOB_BANNER_BOTTOM_ANDROID_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
EXPO_PUBLIC_ADMOB_NATIVE_RESULTS_ANDROID_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
EXPO_PUBLIC_ADMOB_NATIVE_HISTORY_ANDROID_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
EXPO_PUBLIC_ADMOB_ANALYSIS_INTERSTITIAL_ANDROID_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
EXPO_PUBLIC_ADMOB_ANALYSIS_RANDOM_COMBINATION_INTERSTITIAL_ANDROID_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
EXPO_PUBLIC_ADMOB_PICK_RANDOM_COMBINATION_INTERSTITIAL_ANDROID_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
