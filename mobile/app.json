{
  "expo": {
    "name": "PCSO Lotto Results & Analysis",
    "slug": "pcso-live-lotto-results-analysis",
    "version": "0.1.5",
    "orientation": "portrait",
    "icon": "./assets/images/lotto-live-app-icon.png",
    "scheme": "pcsolivelotto",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.lottolens.ph",
      "icon": "./assets/images/lotto-live-app-icon.png"
    },
    "android": {
      "package": "com.kanonsoft.lottoresultsandanalysisph",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#002856",
        "foregroundImage": "./assets/images/lotto-live-logo-transparent.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/lotto-live-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#002856",
          "image": "./assets/images/lotto-live-logo-transparent.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0050A4",
          "defaultChannel": "lotto-result-reminders"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8609264579208618~4357693731",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "optimizeInitialization": true,
          "optimizeAdLoading": true,
          "userTrackingUsageDescription": "This identifier may be used to deliver and measure ads that help support the app."
        }
      ],
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44f03bb9-4605-4689-bdfa-3b02876d1dd5"
      }
    }
  }
}
