{
  "cli": {
    "version": ">= 21.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal"
    },
    "apk": {
      "environment": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "closed-testing": {
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ADS_ENABLED": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ADS_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
